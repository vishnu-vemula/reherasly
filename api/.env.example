# =============================================
# Current API environment variables

# Server
PORT=5000
NODE_ENV=development

# Application database. Require TLS (sslmode=require or verify-full) in production.
DATABASE_URL=postgresql://interviewmaster:local_development_only@127.0.0.1:5432/interviewmaster

# Firebase Admin requires Application Default Credentials for this project.
# If ADC is not configured, set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path.
FIREBASE_PROJECT_ID=taskmanager-a5ac2

# Groq AI (Free LLM API - https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Required for RAG (Converting Resumes & JDs to Vector Embeddings)
OPENAI_API_KEY=your_actual_openai_api_key_here

# Cloudinary (Resume/File Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000

# PayU India hosted checkout. Set PAYU_ENV=test for sandbox.
PAYU_ENV=test
PAYU_MERCHANT_KEY=replace_with_test_merchant_key
PAYU_MERCHANT_SALT=replace_with_test_merchant_salt

# Adzuna job sync. Omit both to disable scheduled external sync.
# ADZUNA_APP_ID=replace_with_adzuna_app_id
# ADZUNA_APP_KEY=replace_with_adzuna_app_key

# Redis is required in production. The local Compose stack provides this URL.
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Number of trusted reverse proxies between clients and this API. Use 0 for
# direct access; use the exact hop count when deployed behind a proxy.
TRUST_PROXY_HOPS=0
